# --- Supabase Postgres connection (see SETUP.md) ---
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used only for migrations)
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth.js (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Supabase Storage (for file uploads, wired in Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- WhatsApp Business API (Phase 4, optional) ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
